# ============ LLM (free hosted tiers) ============
# groq (recommended, free tier: GPT-OSS/Qwen chat + whisper STT)
#   -> get key at https://console.groq.com
# gemini (free tier) -> key at https://aistudio.google.com
# ollama (local) -> no key, base_url http://localhost:11434
LLM_PROVIDER=groq
GROQ_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-oss-120b
LLM_FALLBACK_MODEL=gpt-oss-20b

# ============ VOICE ============
# edge  : free Microsoft Edge online voices (needs internet, no key)
# kokoro: fully offline open model (pip install kokoro; heavy torch dependency)
# elevenlabs: premium (set ELEVENLABS_API_KEY)
TTS_ENGINE=edge
# safety net if edge-tts is blocked/unreachable: sapi = Windows System.Speech
TTS_FALLBACK=sapi
EDGE_VOICE=en-US-AriaNeural
TTS_RATE=+12%
TTS_PITCH=+2Hz
SAPI_RATE=2

# ============ ASSETS (both free) ============
PEXELS_API_KEY=
PIXABAY_API_KEY=

# ============ YOUTUBE PUBLISHING ============
# OAuth — run `python -m agent.cli auth` to generate the tokens/refresh token
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
YT_CHANNEL_ID=

# ============ BEHAVIOUR ============
# Target Short length and hard cap (seconds)
TARGET_SECONDS=50
MAX_SECONDS=60
# Frame spec
VIDEO_WIDTH=1080
VIDEO_HEIGHT=1920
FPS=30
# Stagger 4 daily uploads across these local-time peaks (HH:MM)
PEAK_HOURS=07:00,12:30,17:00,21:00
# Generation time each day (HH:MM). Generation runs here, uploads are scheduled to peaks.
GENERATE_TIME=05:00
# Dry-run safety: when false, nothing is uploaded.
AUTO_UPLOAD=false